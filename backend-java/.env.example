# ─────────────────────────────────────────────────────────────────────────────
# FMGC Warehouse — Java Spring Boot Backend
# Environment Variables Reference
#
# Copy this file to .env for local development.
# On Render, set these in: Dashboard → Your Service → Environment → Add Variable
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
# Render injects PORT automatically — do NOT set this manually on Render.
# For local development only:
PORT=8080

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# On Render: create a PostgreSQL database, then copy the "Internal Database URL"
# from the database dashboard. It looks like:
#   postgresql://user:password@host:5432/dbname
# Prefix it with "jdbc:" to get the JDBC URL:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fmgcdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ── JWT Authentication ────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — use a long random string (32+ characters)
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-secure-random-string-minimum-32-characters

# Token expiry in milliseconds
# 86400000  = 24 hours  (default)
# 604800000 = 7 days
JWT_EXPIRES_IN=86400000

# ── Gemini AI (optional) ──────────────────────────────────────────────────────
# Required only if you use /api/v1/ai/* endpoints.
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set this to your deployed frontend URL on Render.
# For multiple origins, separate with commas (no spaces):
#   CORS_ORIGIN=https://your-frontend.onrender.com,https://your-custom-domain.com
CORS_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# RENDER DEPLOYMENT CHECKLIST
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Create a PostgreSQL database on Render:
#    Render Dashboard → New → PostgreSQL
#    → Copy "Internal Database URL" (use internal URL for same-region latency)
#
# 2. Create a Web Service on Render:
#    Render Dashboard → New → Web Service
#    → Connect your GitHub repository
#    → Root Directory:   backend-java
#    → Environment:      Docker
#    → Instance Type:    Free (or Starter for production)
#
# 3. Set these environment variables in the Web Service:
#    SPRING_DATASOURCE_URL      → jdbc:<your-render-internal-db-url>
#    SPRING_DATASOURCE_USERNAME → (from Render DB dashboard)
#    SPRING_DATASOURCE_PASSWORD → (from Render DB dashboard)
#    JWT_SECRET                 → (generate: openssl rand -base64 48)
#    CORS_ORIGIN                → https://your-frontend.onrender.com
#    GEMINI_API_KEY             → (optional, for AI features)
#
# 4. PORT is set automatically by Render — do NOT add it manually.
#
# 5. After first deploy, the app will:
#    - Create all tables (schema.sql — idempotent, IF NOT EXISTS)
#    - Insert demo seed data (data.sql — idempotent, ON CONFLICT DO NOTHING)
#    - Start listening on Render's assigned port
#
# 6. Health check URL: https://your-service.onrender.com/api/v1/health
#
# 7. Update your frontend's VITE_API_URL to point to the new backend:
#    VITE_API_URL=https://your-service.onrender.com/api/v1
#
# ─────────────────────────────────────────────────────────────────────────────
